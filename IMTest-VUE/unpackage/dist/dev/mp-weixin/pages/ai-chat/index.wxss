
.chat-container.data-v-9edadb70 { height: 100vh; display: flex; flex-direction: column; background: #f5f5f5;
}
.header.data-v-9edadb70 { height: 44px; display: flex; justify-content: space-between; align-items: center; padding: 0 15px; background: #fff; border-bottom: 1px solid #eee; padding-top: var(--status-bar-height); font-weight: bold;
}
.quota-badge.data-v-9edadb70 { font-size: 12px; background: #e6f7ff; color: #1890ff; padding: 4px 8px; border-radius: 12px; font-weight: normal;
}
.quota-badge.warning.data-v-9edadb70 { background: #fff1f0; color: #f5222d;
}
.quota-badge.vip.data-v-9edadb70 { background: #fffbe6; color: #faad14; border: 1px solid #ffe58f;
}
.message-board.data-v-9edadb70 { flex: 1; padding: 15px; box-sizing: border-box;
}
.msg-row.data-v-9edadb70 { display: flex; margin-bottom: 20px; align-items: flex-start;
}
.msg-in.data-v-9edadb70 { justify-content: flex-start;
}
.msg-out.data-v-9edadb70 { justify-content: flex-end;
}
.msg-avatar.data-v-9edadb70 { width: 36px; height: 36px; background: #007aff; color: #fff; border-radius: 4px; display: flex; align-items: center; justify-content: center; font-size: 14px; margin: 0 10px;
}
.msg-in .msg-avatar.data-v-9edadb70 { background: #52c41a;
}
.msg-bubble.data-v-9edadb70 { max-width: 65%; padding: 10px; border-radius: 8px; background: #fff; line-height: 1.5; font-size: 15px;
}
.msg-out .msg-bubble.data-v-9edadb70 { background: #007aff; color: #fff;
}
.input-area.data-v-9edadb70 { display: flex; padding: 10px 15px; background: #fff; border-top: 1px solid #eee; padding-bottom: calc(10px + env(safe-area-inset-bottom));
}
.chat-input.data-v-9edadb70 { flex: 1; background: #f5f5f5; height: 40px; border-radius: 20px; padding: 0 15px;
}
.send-btn.data-v-9edadb70 { margin-left: 10px; width: 60px; height: 40px; line-height: 40px; background: #007aff; color: #fff; border-radius: 20px; font-size: 14px; padding: 0;
}
.pay-wall.data-v-9edadb70 { padding: 20px 15px; background: #fff; border-top: 1px solid #eee; padding-bottom: calc(20px + env(safe-area-inset-bottom)); text-align: center;
}
.pay-tip.data-v-9edadb70 { font-size: 14px; color: #666; margin-bottom: 15px; display: block;
}
.btn-course.data-v-9edadb70 { background: #ff758c; color: #fff; border-radius: 25px; font-size: 15px; font-weight: bold;
}
